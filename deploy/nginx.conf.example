# Example production nginx routing for AoE2HDBets
# Adjust TLS cert paths and domain names to your environment.

server {
    listen 80;
    server_name aoe2war.com www.aoe2war.com;
    return 301 https://aoe2war.com$request_uri;
}

server {
    listen 443 ssl http2;
    server_name aoe2war.com www.aoe2war.com;

    # ssl_certificate     /etc/letsencrypt/live/aoe2war.com/fullchain.pem;
    # ssl_certificate_key /etc/letsencrypt/live/aoe2war.com/privkey.pem;

    location ^~ /rpc/ {
        proxy_pass http://127.0.0.1:26657/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        add_header Access-Control-Allow-Origin $http_origin always;
        add_header Access-Control-Allow-Methods "GET, POST, OPTIONS" always;
        add_header Access-Control-Allow-Headers "Content-Type, Authorization, X-Requested-With" always;
        add_header Vary "Origin" always;
    }

    location ^~ /rest/ {
        proxy_pass http://127.0.0.1:1317/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        add_header Access-Control-Allow-Origin $http_origin always;
        add_header Access-Control-Allow-Methods "GET, POST, OPTIONS" always;
        add_header Access-Control-Allow-Headers "Content-Type, Authorization, X-Requested-With" always;
        add_header Vary "Origin" always;
    }

    # Living Kingdom public receive-only EventSource. Keep this exact location
    # above the general app proxy so Nginx never buffers or upgrades the stream.
    # The application keepalive must remain shorter than proxy_read_timeout.
    location = /api/kingdom-presence/events {
        proxy_pass http://127.0.0.1:3030;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_cache off;
        proxy_read_timeout 75s;
        proxy_send_timeout 75s;
        proxy_socket_keepalive on;
        gzip off;
        add_header X-Accel-Buffering "no" always;
        add_header Cache-Control "no-store" always;
    }

    location / {
        proxy_pass http://127.0.0.1:3030;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }
}

server {
    listen 80;
    server_name api-prodn.aoe2war.com;
    return 301 https://api-prodn.aoe2war.com$request_uri;
}

server {
    listen 443 ssl http2;
    server_name api-prodn.aoe2war.com;

    # ssl_certificate     /etc/letsencrypt/live/api-prodn.aoe2war.com/fullchain.pem;
    # ssl_certificate_key /etc/letsencrypt/live/api-prodn.aoe2war.com/privkey.pem;

    location / {
        proxy_pass http://127.0.0.1:3330;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
