[Unit]
Description=AoE2WAR Storage Sentinel offline signed three-drive receipt admission
After=local-fs.target
ConditionPathExists=/var/lib/aoe2war-storage-sentinel/state.sqlite3
ConditionPathExists=/var/lib/aoe2war-storage-sentinel/three-receipts.json

[Service]
Type=oneshot
User=aoe2war-sentinel
Group=aoe2war-sentinel
WorkingDirectory=/var/www/AoE2HDBets/app-prodn
ExecStart=/usr/bin/python3 /var/www/AoE2HDBets/app-prodn/scripts/aoe2_storage_sentinel.py ingest --state /var/lib/aoe2war-storage-sentinel/state.sqlite3 --trust /var/lib/aoe2war-storage-sentinel/trust.json --signed /var/lib/aoe2war-storage-sentinel/three-receipts.json
NoNewPrivileges=yes
PrivateNetwork=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/aoe2war-storage-sentinel
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryMax=192M
RuntimeMaxSec=45
