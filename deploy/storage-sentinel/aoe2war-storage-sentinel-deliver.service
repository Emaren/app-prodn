[Unit]
Description=AoE2WAR Storage Sentinel operator-only inbox outbox retry
After=network-online.target
Wants=network-online.target
ConditionPathExists=/var/lib/aoe2war-storage-sentinel/state.sqlite3

[Service]
Type=oneshot
User=aoe2war-sentinel
Group=aoe2war-sentinel
WorkingDirectory=/var/www/AoE2HDBets/app-prodn
EnvironmentFile=/etc/aoe2war/storage-sentinel-private.env
ExecStart=/usr/bin/python3 /var/www/AoE2HDBets/app-prodn/scripts/aoe2_storage_sentinel.py deliver --state /var/lib/aoe2war-storage-sentinel/state.sqlite3
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/aoe2war-storage-sentinel
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryMax=256M
RuntimeMaxSec=60
