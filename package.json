    "dev:shadow:fresh": "npm run shadow:refresh && npm run dev:shadow",
    "bets:jims-rule-backfill": "node --experimental-strip-types --experimental-loader ./scripts/aoe2-alias-loader.mjs scripts/audit-backfill-jims-rule.mts",
    "challenge:emaren23": "node --experimental-strip-types --experimental-loader ./scripts/aoe2-alias-loader.mjs scripts/audit-settle-emaren-challenge-23.mts",
