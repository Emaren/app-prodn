  "terms": [
    {
      "term": "GROSS_ALLOCATED",
      "definition": "st_blocks or source-equivalent allocation; sums may overlap, never equal reclaim by default"
    },
    {
      "term": "UNIQUE_EXCLUSIVE",
      "definition": "Allocated extents proven nonoverlapping across categories; unknown until original inode/clone proof"
    },
    {
      "term": "PHYSICAL_RECLAIM",
      "definition": "Native same-filesystem available-space delta after authorized completed operation; not gross directory sizes"
    },
    {
      "term": "HOT_SCAN",
      "definition": "Capacity and cached receipt metadata only, no source traversal or new signatures"
    },
    {
      "term": "INCREMENTAL_SCAN",
      "definition": "Revalidate bounded registered source identities and rehash only changed source files"
    },
    {
      "term": "DEEP_SCAN",
      "definition": "Bounded explicit reason-driven hash investigation; never an unrestricted whole-disk crawler"
    },
    {
      "term": "COPY_ONLY",
      "definition": "Durable verified recipient object while original source is preserved; not retirement"
    },
    {
      "term": "RETIRE",
      "definition": "Different signed one-use owner action requiring independent restored proof, original rollback guards and root nonce ledger"
    },
    {
      "term": "UNKNOWN",
      "definition": "Missing, stale, overlapping or unsigned evidence; not zero, passed or reusable"
    },
    {
      "term": "L4",
      "definition": "Original human-only retirement classification; never inferred from lower-level maintenance"
    },
    {
      "term": "L5",
      "definition": "Never-delete protected original or original legal/financial/custody material"
    },
    {
      "term": "T10",
      "definition": "Original source/BUILD exact deployment acceptance with proven rollback and restoration, not PR merge"
    }
  ]
}
