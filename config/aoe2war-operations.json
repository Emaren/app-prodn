{
  "schema": 1,
  "project": "AoE2WAR",
  "canonical": {
    "branch": "main",
    "github_repository": "Emaren/app-prodn",
    "production_host": "hel1",
    "production_repo": "/var/www/AoE2HDBets/app-prodn",
    "service": "aoe2hdbets-web.service",
    "public_base_url": "https://aoe2war.com",
    "web_bind": "127.0.0.1:3030",
    "deployment_manager": "systemd",
    "volume_mount": "/mnt/HC_Volume_105319120",
    "global_release_lock": "/mnt/HC_Volume_105319120/aoe2war/os-control/locks/release.lock",
    "control_store": "/mnt/HC_Volume_105319120/aoe2war/os-control",
    "bridge_env_file": "/etc/aoe2hdbets/aoe2war-os-bridge.env",
    "bridge_systemd_dropin": "/etc/systemd/system/aoe2hdbets-web.service.d/60-aoe2war-os.conf",
    "bridge_token_file": "~/.config/aoe2war/os-bridge-token",
    "bridge_launchagent": "~/Library/LaunchAgents/com.aoe2war.operator-bridge.plist",
    "bridge_launchagent_label": "com.aoe2war.operator-bridge"
  },
  "protected": {
    "wolo_runtime_mutation_policy": "observe-only-unless-explicitly-authorized",
    "wolo_listener_ports": [
      8092,
      8093
    ],
    "database_automatic_migration_policy": "fail-closed-reviewed-lane"
  },
  "components": {
    "web": {
      "release_automation": "protected-certified"
    },
    "replay_api": {
      "local_repo": "../api-prodn",
      "production_repo": "/var/www/AoE2HDBets/api-prodn",
      "branch": "main",
      "service": "aoe2hdbets-api.service",
      "bind": "127.0.0.1:3330",
      "health_url": "http://127.0.0.1:3330/health",
      "release_automation": "verify-only-until-dependency-and-migration-lane-is-certified"
    }
  },
  "toolchain": {
    "node_major": 22,
    "operator_node_majors": [
      22,
      24
    ],
    "python_major_minor": "3.13",
    "yarn": "1.22.22",
    "next": "15.1.7",
    "prisma": "7.4.0",
    "node_policy": "build-and-production-use-node-22; operator-node-22-or-24-supported"
  },
  "capacity": {
    "root_free_warn_gib": 5.0,
    "root_free_preferred_gib": 6.0,
    "volume_used_warn_percent": 85,
    "volume_used_critical_percent": 92
  },
  "storage_retention": {
    "default_mode": "preview-read-only",
    "durable_rollback_root": "/mnt/HC_Volume_105319120/aoe2war/rollbacks",
    "receipt_root": "/mnt/HC_Volume_105319120/aoe2war/os-control/storage-retention-receipts",
    "lock_path": "/mnt/HC_Volume_105319120/aoe2war/os-control/locks/storage-retention.lock",
    "activation_generation_prefix": "activate-",
    "source_cache_relative_path": ".next/cache",
    "durable_cache_relative_path": "next/cache",
    "protect_newest_activation_generations": 2,
    "delete_generation_directories": false,
    "require_plan_digest_recheck": true,
    "require_runtime_identity_recheck": true
  },
  "operator_bridge": {
    "online_threshold_seconds": 45,
    "poll_interval_seconds": 3,
    "minimum_version": "1.2.0",
    "required_capabilities": [
      "finish"
    ],
    "direction": "outbound-only",
    "arbitrary_shell": false
  },
  "finish": {
    "auto_commit_local_worktree": true,
    "auto_publish_clean_local_commits": true,
    "vps_candidate_adoption": "tracked-existing-files-only-exact-base",
    "vps_untracked_files": "fail-closed",
    "auto_storage_retention": true,
    "host_execution": "operator-local-or-production-delegated-through-fixed-action-bridge",
    "global_serialization": "canonical-production-volume-lease",
    "database_migrations": "not-auto-applied",
    "wolo_runtime_mutation": false,
    "final_requirement": "certified-production-and-estate-p0-0-p1-0"
  },
  "semantic_maps": {
    "required_terms": [
      "AoE2WAR",
      "8092",
      "8093",
      "/mnt/HC_Volume_105319120/aoe2war/rollbacks/",
      "Operator Bridge",
      "/mnt/HC_Volume_105319120/aoe2war/os-control"
    ]
  },
  "offsite_evidence": {
    "enabled": false,
    "authority": null,
    "restore_proof": null,
    "note": "Pending high-ROI off-host encrypted evidence vault and restore drill."
  },
  "legacy_deployment_artifacts": {
    "ecosystem.config.js": "must-be-absent",
    "Dockerfile": "must-be-absent"
  }
}
