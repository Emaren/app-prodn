#!/usr/bin/env bash
set -euo pipefail

BIN_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
SELF_ROOT="$(cd -- "$BIN_DIR/.." && pwd -P)"

resolve_git_common_dir() {
  local repo="$1"
  local raw

  raw="$(
    git -C "$repo" \
      rev-parse \
      --git-common-dir \
      2>/dev/null
  )" || return 1

  if [[ "$raw" = /* ]]; then
    (
      cd "$raw"
      pwd -P
    )
  else
    (
      cd "$repo/$raw"
      pwd -P
    )
  fi
}

CALLER_ROOT="$(
  git -C "$PWD" \
    rev-parse \
    --show-toplevel \
    2>/dev/null \
  || true
)"

if (
  [ -n "$CALLER_ROOT" ] &&
  [ "$CALLER_ROOT" != "$SELF_ROOT" ] &&
  [ -x "$CALLER_ROOT/bin/aoe2war" ]
); then
  SELF_COMMON="$(
    resolve_git_common_dir "$SELF_ROOT" \
    || true
  )"

  CALLER_COMMON="$(
    resolve_git_common_dir "$CALLER_ROOT" \
    || true
  )"

  if (
    [ -n "$SELF_COMMON" ] &&
    [ "$SELF_COMMON" = "$CALLER_COMMON" ]
  ); then
    exec \
      "$CALLER_ROOT/bin/aoe2war" \
      "$@"
  fi
fi
RELEASE="$BIN_DIR/aoe2war-release"
AUDIT="$BIN_DIR/../scripts/aoe2_audit.py"
DOCTOR="$BIN_DIR/../scripts/aoe2_doctor.py"
UPDATE="$BIN_DIR/../scripts/aoe2_update.py"
FINISH="$BIN_DIR/../scripts/aoe2_finish.py"
BRIDGE="$BIN_DIR/../scripts/aoe2_operator_bridge.py"
STORAGE_RETENTION="$BIN_DIR/../scripts/aoe2_storage_retention.py"
STORAGE="$BIN_DIR/../scripts/aoe2_storage.py"
SPEED="$BIN_DIR/../scripts/aoe2_speed.py"
DOCS_OS="$BIN_DIR/../scripts/aoe2_docs.py"
COUNCIL="$BIN_DIR/../scripts/aoe2_council.py"
WORKSPACE="$BIN_DIR/../scripts/aoe2_workspace.py"
HOST_OS="$BIN_DIR/../scripts/aoe2_host.py"
RECOVERY_OS="$BIN_DIR/../scripts/aoe2_recovery.py"
SPEED_PULSE="$BIN_DIR/../scripts/aoe2_speed_pulse.py"
FACTS="$BIN_DIR/../scripts/aoe2_facts.py"
DEV_OS="$BIN_DIR/../scripts/aoe2_dev.py"
DEPENDENCY_CHECK="$BIN_DIR/../scripts/check_dependency_contract.py"

usage() {
  cat <<'EOF'
AoE2WAR operator CLI

Usage:
  aoe2war info
  aoe2war deploy [release options]
  aoe2war audit [--json]
  aoe2war doctor [--json] [--strict]
  aoe2war update [--apply] [--json]
  aoe2war docs <status|impact|audit|update> [options]
  aoe2war speed [status|release-history|benchmark|compare|diagnose|pulse]
  aoe2war storage-retention [--apply] [--json]
  aoe2war storage <status|plan|maintain|verify> [options]
  aoe2war council [--json]
  aoe2war workspace <status|plan|clean> [options]
  aoe2war facts [--json]
  aoe2war dev <status|prepare|refresh|serve|new> [options]
  aoe2war deps
  aoe2war host <status|tidy|maintenance-plan> [options]
  aoe2war recovery <status|plan> [options]
  aoe2war finish [--dry-run] [--json] [-m MESSAGE]
  aoe2war bridge [--once] [bridge options]
  aoe2war status [--json]
  aoe2war context [--json]
  aoe2war releases [--limit N] [--json]
  aoe2war rollback [--dry-run] [--json]
  aoe2war gate [--json]
  aoe2war manifest [--json]
  aoe2war release <raw release-engine command/options>

Examples:
  aoe2war info
  aoe2war audit
  aoe2war audit --json
  aoe2war doctor
  aoe2war update
  aoe2war update --apply
  aoe2war storage-retention
  aoe2war storage-retention --apply
  aoe2war finish
  aoe2war bridge --once
  aoe2war deploy
  aoe2war deploy --dry-run
  aoe2war status
  aoe2war releases --limit 5
  aoe2war rollback --dry-run
  aoe2war rollback
EOF
}

info() {
  cat <<'EOF'
⚔️  AoE2WAR Operator Guide

The normal commands, in plain English.

SAFE / READ-ONLY

  aoe2war info
      Show this guide. Use it when you come back later and want to remember
      what the operator tools do.

  aoe2war status
      Quick release/deployment state: local source, GitHub, production,
      certification and what the release engine thinks should happen next.

  aoe2war audit
      Exhaustive read-only estate check. Verifies Git, all documentation
      authorities, production health, protected Wolo listeners, system maps
      and context evidence. Makes no changes.

  aoe2war doctor
      Operator-grade read-only health check beyond the estate audit. Adds host
      hygiene, toolchains, Operator Bridge, capacity, semantic map completeness,
      architecture seams and disaster-recovery readiness. Warnings are advisory;
      blockers return nonzero.

  aoe2war docs status
      Show cheap documentation health: implementation baseline, semantic impact,
      source registry, central federation/taxonomy state and review freshness.

  aoe2war docs impact
      Map implementation changes to ranked living-document review candidates.
      High-risk contract changes require semantic review; ordinary application
      work defaults to generated-registry refresh only.

  aoe2war docs audit
      Run the full documentation control-plane validation in an isolated central
      docs worktree so the canonical AoE2WAR-docs repository is not rewritten.

  aoe2war docs update [--apply]
      Documentation-OS entry point to the existing protected update engine.
      The legacy top-level `aoe2war update` remains a compatible alias.

  aoe2war update
      Plan documentation/context maintenance. Shows exactly what would change.
      Makes no changes.

  aoe2war storage-retention
      Preview the exact regenerable .next/cache material eligible inside older
      durable activation rollback generations. Protects the newest two and
      makes no production or receipt change.

DOCUMENTATION / CONTEXT WRITE

  aoe2war update --apply
      Reconcile repository documentation baselines, the central AoE2WAR-docs
      federation and stale context archives. It does NOT deploy production,
      mutate the database, change Wolo runtime state or upgrade dependencies.

BOUNDED STORAGE WRITE

  aoe2war storage-retention --apply
      Persist a durable plan, recheck its digest, then remove only the planned
      cache directories from older activation rollback generations. Generation
      evidence and BUILD_ID remain; source/build/service and protected Wolo
      listener counts must remain unchanged and are recorded afterward.

ADMIN UI / OPERATOR BRIDGE

  aoe2war bridge
      Keep this operator machine connected outbound to Admin > AoE2WAR OS.
      The website can queue only allow-listed actions; this bridge executes the
      existing protected CLI locally and streams progress/results back.

  aoe2war bridge --once
      Heartbeat, claim at most one queued Admin action, then exit.

PRODUCTION WRITE

  aoe2war finish
      Canonical end-of-work command. Reconciles Mac/GitHub source authority,
      safely adopts a tracked VPS-first candidate only from one exact base,
      gates and commits unpublished work, refreshes documentation/context,
      deploys if needed, certifies production, runs the final estate audit and
      Doctor, and leaves one aggregate receipt. Wolo remains observe-only.

  aoe2war deploy
      Ship the current eligible application revision through the protected
      release pipeline and certification gates.

  aoe2war rollback --dry-run
      Preview the protected rollback target. Makes no production change.

  aoe2war rollback
      Activate the previous protected production generation.

ADVANCED / DIAGNOSTIC

  aoe2war releases
      Show recent release history.

  aoe2war gate
      Inspect release eligibility.

  aoe2war manifest
      Inspect release artifact identity.

  aoe2war context
      Show release-engine context/state.

  aoe2war release ...
      Direct low-level access to the release engine. Use only when you know
      exactly which release-engine operation you want.

KINGDOM INTELLIGENCE / HYGIENE

  aoe2war council
      Read-only prioritized command center. Combines Audit, Doctor, Storage,
      Host, Recovery, Workspace and Performance evidence into ranked practical
      recommendations with one best next action.

  aoe2war speed pulse
      Cheap persisted critical-route public performance pulse. `aoe2war finish`
      runs this automatically after certification without weakening release truth.

  aoe2war workspace status
      Classify registered worktrees as main, clean+merged cleanup candidates,
      dirty preserved review, or active unmerged work. Unregistered siblings are
      surfaced but never removed automatically.

  aoe2war workspace clean [--apply]
      Preview or remove only clean registered worktrees whose HEAD is already an
      ancestor of main. Dirty, unmerged and unregistered directories are protected.

  aoe2war host status
      Read-only host hygiene: reboot/update state, transient release failures,
      Traffic rollup timer and protected web/API/Wolo health.

  aoe2war host tidy [--apply]
      Reset only failed AoE2WAR build/dependency transient instances and, in the
      full lane, daemon-reload/rearm the known Traffic rollup timer. No package
      upgrades and no reboot.

  aoe2war host maintenance-plan
      Plan protected package/reboot maintenance. Fail closed until the off-host
      Recovery OS contract has a named authority and verified restore proof.

  aoe2war recovery status
      Show whether encrypted off-host Evidence Vault + restore proof is actually
      configured. Local/mounted copies do not count as off-host recovery.

  aoe2war recovery plan
      Show the exact fail-closed steps required before host patch/reboot work.

NORMAL RHYTHM

  Before work:
      aoe2war status

  Want full confidence:
      aoe2war audit

  Finished coding:
      aoe2war finish

  Want to see exactly what finish would do first:
      aoe2war finish --dry-run

  Manual maintenance/release primitives remain available:
      aoe2war update --apply
      aoe2war deploy

  Months later and forgot the commands:
      aoe2war info

Syntax-only help:
      aoe2war --help
EOF
}

command="${1:-help}"
case "$command" in
  info)
    info
    ;;
  deploy)
    shift
    exec "$RELEASE" ship "$@"
    ;;
  audit)
    shift
    exec python3 "$AUDIT" "$@"
    ;;
  doctor)
    shift
    exec python3 "$DOCTOR" "$@"
    ;;
  docs)
    shift
    exec python3 "$DOCS_OS" "$@"
    ;;
  update)
    shift
    exec python3 "$UPDATE" "$@"
    ;;
  storage-retention)
    shift
    exec python3 "$STORAGE_RETENTION" "$@"
    ;;
  storage)
    shift
    exec python3 "$STORAGE" "$@"
    ;;
  speed)
    shift
    if [ "${1:-}" = "pulse" ]; then
      shift
      exec python3 "$SPEED_PULSE" "$@"
    fi
    exec python3 "$SPEED" "$@"
    ;;
  council)
    shift
    exec python3 "$COUNCIL" "$@"
    ;;
  workspace)
    shift
    exec python3 "$WORKSPACE" "$@"
    ;;
  facts)
    shift
    exec python3 "$FACTS" "$@"
    ;;
  dev)
    shift
    exec python3 "$DEV_OS" "$@"
    ;;
  deps)
    shift
    exec python3 "$DEPENDENCY_CHECK" "$@"
    ;;
  host)
    shift
    exec python3 "$HOST_OS" "$@"
    ;;
  recovery)
    shift
    exec python3 "$RECOVERY_OS" "$@"
    ;;
  finish)
    shift
    exec python3 "$FINISH" "$@"
    ;;
  bridge)
    shift
    exec python3 "$BRIDGE" "$@"
    ;;
  status|context|releases|rollback|gate|manifest)
    shift
    exec "$RELEASE" "$command" "$@"
    ;;
  release)
    shift
    exec "$RELEASE" "$@"
    ;;
  help|-h|--help)
    usage
    ;;
  *)
    echo "STOP: unknown AoE2WAR command: $command" >&2
    echo >&2
    usage >&2
    exit 2
    ;;
esac
