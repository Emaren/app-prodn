#!/usr/bin/env bash
set -euo pipefail

tool="${1:?tool name required}"
shift || true

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

candidates=()

# 1) explicit env var points at llama-scripts repo root (works everywhere)
if [[ -n "${LLAMA_SCRIPTS_DIR:-}" ]]; then
  candidates+=("${LLAMA_SCRIPTS_DIR}/bin/${tool}")
  # also try without ".sh" in case llama-scripts uses names without extension
  if [[ "$tool" == *.sh ]]; then
    candidates+=("${LLAMA_SCRIPTS_DIR}/bin/${tool%.sh}")
  fi
fi

# 2) vendored inside this repo (if you ever add it later)
candidates+=("${repo_root}/llama-scripts/bin/${tool}")
if [[ "$tool" == *.sh ]]; then
  candidates+=("${repo_root}/llama-scripts/bin/${tool%.sh}")
fi

# 3) your Mac path (harmless on Linux)
candidates+=("/Users/tonyblum/projects/llama-scripts/bin/${tool}")
if [[ "$tool" == *.sh ]]; then
  candidates+=("/Users/tonyblum/projects/llama-scripts/bin/${tool%.sh}")
fi

for p in "${candidates[@]}"; do
  if [[ -x "$p" ]]; then
    exec "$p" "$@"
  fi
done

echo "❌ '$tool' not found or not executable."
echo "LLAMA_SCRIPTS_DIR=${LLAMA_SCRIPTS_DIR:-<unset>}"
echo "Set LLAMA_SCRIPTS_DIR to the llama-scripts repo root, e.g.:"
echo "  export LLAMA_SCRIPTS_DIR=\$HOME/projects/llama-scripts"
echo "Tried:"
printf '  - %s\n' "${candidates[@]}"
exit 127
