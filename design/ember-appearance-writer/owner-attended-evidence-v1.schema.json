{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aoe2war.example/schema/ember-owner-attended-evidence-v1",
  "title": "Historical Ember owner-attended evidence, never a permit",
  "description": "Diagnostic records only. Forbidden as Factory or SQL activation authority. One use and one historical source/date; no signature issuance.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "aoe2war.ember.owner-attended-evidence.v1"
    },
    "purpose": {
      "const": "NOVEMBER_NONFINANCIAL_RELEASE_ONLY"
    },
    "authority_kind": {
      "const": "OWNER_ATTENDED_ROOT_MANUAL_EXCEPTION"
    },
    "authority_state": {
      "const": "UNSIGNED_NOT_A_PERMIT"
    },
    "actor": {
      "const": "owner-present-root-tty"
    },
    "host": {
      "const": "ubuntu-4gb-hel1-11"
    },
    "database": {
      "const": "aoe2hd_db"
    },
    "source_commit": {
      "const": "f50ead889c6101115aaf678ebdfa70650b691552"
    },
    "build_id": {
      "const": "eyhY43hMRs2EZknN3Cht3"
    },
    "sql_apply_sha256": {
      "const": "3adf4296436fcb4d20a2261c7a12f0894b4df8aceadcb6e0e5d6f3a967c151e3"
    },
    "sql_inverse_sha256": {
      "const": "65270456e8fd957019a84b617e5a86de901b1e69e61369272e260151358068ed"
    },
    "writer_unit_sha256": {
      "const": "d231c8d0e3401717ea37991e93a63ec8394bfb6c4c8e56cd807c20fc1ed5e7b9"
    },
    "runtime_archive_sha256": {
      "const": "3701674709ed759113445eb574882c00d41eeba79f5892f9f3bb0842feab53af"
    },
    "independent_proof_sha256": {
      "const": "0811a74e190d1d9dfc0df848eb1e167bf8d33f3622d10d6847c634bb0678b8f3"
    },
    "previous_web_root": {
      "const": "/var/lib/aoe2war-web-prod-e31e1c053a3b"
    },
    "financial_authorized": {
      "const": false
    },
    "funding_authorized": {
      "const": false
    },
    "factory_permit_claimed": {
      "const": false
    },
    "cryptographic_signature_claimed": {
      "const": false
    },
    "sql_stage_status": {
      "type": "string",
      "enum": [
        "NOT_STARTED",
        "STAGED_NOT_EXECUTED",
        "PASS",
        "HOLD",
        "FAILED"
      ]
    },
    "service_status": {
      "type": "string",
      "enum": [
        "NOT_STARTED",
        "STAGED_NOT_EXECUTED",
        "PASS",
        "HOLD",
        "FAILED"
      ]
    },
    "factory_status": {
      "type": "string",
      "enum": [
        "NOT_STARTED",
        "STAGED_NOT_EXECUTED",
        "PASS",
        "HOLD",
        "FAILED"
      ]
    },
    "observed_utc": {
      "type": "string",
      "format": "date-time",
      "pattern": "^2026-11-16T"
    },
    "evidence_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "required": [
    "actor",
    "authority_kind",
    "authority_state",
    "build_id",
    "cryptographic_signature_claimed",
    "database",
    "evidence_sha256",
    "factory_permit_claimed",
    "factory_status",
    "financial_authorized",
    "funding_authorized",
    "host",
    "independent_proof_sha256",
    "observed_utc",
    "previous_web_root",
    "purpose",
    "runtime_archive_sha256",
    "schema",
    "service_status",
    "source_commit",
    "sql_apply_sha256",
    "sql_inverse_sha256",
    "sql_stage_status",
    "writer_unit_sha256"
  ]
}
