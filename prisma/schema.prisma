/// Immutable bounded reprocessing manifest. Runtime state and checkpoints are an
/// append-only ReplayReprocessJobEvent stream.
model ReplayReprocessJob {
  id                      Int      @id @default(autoincrement())
  requestedByUserId       Int?     @map("requested_by_user_id")
  idempotencyKey          String   @unique(map: "uq_replay_reprocess_jobs_idempotency") @map("idempotency_key") @db.VarChar(128)
  jobIdentityHash         String   @unique(map: "uq_replay_reprocess_jobs_identity") @map("job_identity_hash") @db.VarChar(64)
  scopeKind               String   @map("scope_kind") @db.VarChar(40)
  scope                   Json
  scopeHash               String   @map("scope_hash") @db.VarChar(64)
  parserName              String   @map("parser_name") @db.VarChar(64)
  parserVersion           String   @map("parser_version") @db.VarChar(64)
  passName                String   @map("pass_name") @db.VarChar(64)
  passVersion             String   @map("pass_version") @db.VarChar(64)
  parserConfigHash        String   @map("parser_config_hash") @db.VarChar(64)
  batchSize               Int      @default(50) @map("batch_size")
  maxArtifacts            Int      @map("max_artifacts")
  maxAttemptsPerArtifact  Int      @default(2) @map("max_attempts_per_artifact")
  dryRun                  Boolean  @default(true) @map("dry_run")
  candidateOnly           Boolean  @default(true) @map("candidate_only")
  affectsPublicAggregates Boolean  @default(false) @map("affects_public_aggregates")
  createdAt               DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  requestedBy User?                     @relation("ReplayReprocessJobCreator", fields: [requestedByUserId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  events      ReplayReprocessJobEvent[]

  @@index([requestedByUserId, createdAt], map: "ix_replay_reprocess_jobs_requester")
  @@index([scopeKind, createdAt], map: "ix_replay_reprocess_jobs_scope_created")
  @@map("replay_reprocess_jobs")
}

/// Immutable event/checkpoint stream for a bounded reprocessing job. Sequence zero is
/// queued; every later event advances exactly one sequence number.
model ReplayReprocessJobEvent {
  id               Int      @id @default(autoincrement())
  jobId            Int      @map("job_id")
  artifactId       Int?     @map("artifact_id")
  parseRunId       Int?     @map("parse_run_id")
  idempotencyKey   String   @unique(map: "uq_replay_reprocess_events_idempotency") @map("idempotency_key") @db.VarChar(128)
  sequence         Int
  eventType        String   @map("event_type") @db.VarChar(32)
  workerKey        String?  @map("worker_key") @db.VarChar(128)
  checkpointCursor String?  @map("checkpoint_cursor") @db.VarChar(500)
  attemptNumber    Int      @default(0) @map("attempt_number")
  processedCount   Int      @default(0) @map("processed_count")
  succeededCount   Int      @default(0) @map("succeeded_count")
  failedCount      Int      @default(0) @map("failed_count")
  skippedCount     Int      @default(0) @map("skipped_count")
  detail           Json?
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  job      ReplayReprocessJob @relation(fields: [jobId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  artifact ReplayArtifact?    @relation(fields: [artifactId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  parseRun ReplayParseRun?    @relation(fields: [parseRunId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@unique([jobId, sequence], map: "uq_replay_reprocess_events_job_sequence")
  @@index([jobId, createdAt], map: "ix_replay_reprocess_events_job_created")
  @@index([artifactId, createdAt], map: "ix_replay_reprocess_events_artifact")
  @@index([eventType, createdAt], map: "ix_replay_reprocess_events_type_created")
  @@map("replay_reprocess_job_events")
}

