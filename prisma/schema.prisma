generator client {
  provider = "prisma-client-js"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                        Int       @id @default(autoincrement())
  uid                       String    @unique @db.VarChar(100)
  email                     String?   @unique(map: "ix_users_email") @db.VarChar(100)
  inGameName                String?   @unique @map("in_game_name") @db.VarChar
  verified                  Boolean   @default(false)
  walletAddress             String?   @map("wallet_address") @db.VarChar(100)
  lockName                  Boolean   @default(false) @map("lock_name")
  createdAt                 DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  token                     String?   @db.VarChar(128)
  lastSeen                  DateTime? @map("last_seen") @db.Timestamp(6)
  isAdmin                   Boolean   @default(false) @map("is_admin")
  canReviewOwnReplayResults Boolean   @default(false) @map("can_review_own_replay_results")
  preferredLanguage         String?   @map("preferred_language") @db.VarChar(12)

  // NOTE: DB has a partial unique index (WHERE steam_id IS NOT NULL).
  // Prisma can't represent partial uniqueness here, so we map to the index name
  // and rely on the DB for enforcement.
  steamId                     String?   @unique(map: "uq_users_steam_id") @map("steam_id") @db.VarChar(32)
  steamPersonaName            String?   @map("steam_persona_name") @db.VarChar(255)
  twitchStreamUrl             String?   @map("twitch_stream_url") @db.VarChar(500)
  representedCountry          String?   @map("represented_country") @db.VarChar(40)
  representedCountryUpdatedAt DateTime? @map("represented_country_updated_at") @db.Timestamp(6)
  genderDivision              String    @default("Man") @map("gender_division") @db.VarChar(16)
  genderDivisionUpdatedAt     DateTime? @map("gender_division_updated_at") @db.Timestamp(6)
  verificationLevel           Int       @default(0) @map("verification_level")
  verificationMethod          String    @default("none") @map("verification_method") @db.VarChar(32)
  verifiedAt                  DateTime? @map("verified_at") @db.Timestamp(6)

  apiKeys                        ApiKey[]
  gameStats                      GameStats[]
  tournamentEntries              TournamentEntry[]
  chatMessages                   ChatMessage[]
  chatMessageReactions           ChatMessageReaction[]
  createdTournaments             Tournament[]                    @relation("TournamentCreator")
  directConversationParticipants DirectConversationParticipant[] @relation("DirectConversationParticipantUser")
  directMessagesSent             DirectMessage[]                 @relation("DirectMessageSender")
  directMessageReactions         DirectMessageReaction[]
  directMessagePins              DirectMessagePin[]              @relation("DirectMessagePinUser")
  directMessageDrafts            DirectMessageDraft[]
  communityRequestsCreated       CommunityRequest[]              @relation("CommunityRequestAuthor")
  communityRequestsCompleted     CommunityRequest[]              @relation("CommunityRequestCompleter")
  communityRequestVotes          CommunityRequestVote[]
  communityRequestComments       CommunityRequestComment[]       @relation("CommunityRequestCommentAuthor")
  receivedBadges                 UserBadge[]                     @relation("UserBadgeRecipient")
  grantedBadges                  UserBadge[]                     @relation("UserBadgeCreator")
  receivedGifts                  UserGift[]                      @relation("UserGiftRecipient")
  grantedGifts                   UserGift[]                      @relation("UserGiftCreator")
  appearancePreference           UserAppearancePreference?
  activityEvents                 UserActivityEvent[]
  watcherDownloadEvents          WatcherDownloadEvent[]
  watcherClientEvents            WatcherClientEvent[]
  gameWatchStreams               GameWatchStream[]               @relation("GameWatchStreamOwner")
  betWagers                      BetWager[]
  betStakeIntents                BetStakeIntent[]
  betStakeTickets                BetStakeTicket[]
  betAutoPreset                  BetAutoPreset?
  betMarketWallets               BetMarketWallet[]
  betMarketFinancialAdjustments  BetMarketFinancialAdjustment[]
  reviewedPlayerIdentityAliases  PlayerIdentityAlias[]
  createdBetFounderBonuses       BetMarketFounderBonus[]         @relation("BetMarketFounderBonusCreator")
  stakingPosition                StakingPosition?
  stakingEvents                  StakingEvent[]
  stakingRewardAllocations       StakingRewardAllocation[]
  scheduledChallengesCreated     ScheduledMatch[]                @relation("ScheduledMatchChallenger")
  scheduledChallengesReceived    ScheduledMatch[]                @relation("ScheduledMatchChallenged")
  scheduledMatchActivities       ScheduledMatchActivity[]        @relation("ScheduledMatchActivityActor")
  scheduledMatchPreferences      ScheduledMatchUserPreference[]
  trophiesHeld                   Trophy[]                        @relation("TrophyCurrentHolder")
  trophiesGuarded                Trophy[]                        @relation("TrophyGuardianHolder")
  trophyEconomicsChanges         TrophyEconomicsVersion[]        @relation("TrophyEconomicsChangedBy")
  trophyEventsActed              TrophyEvent[]                   @relation("TrophyEventActor")
  trophyEventsFrom               TrophyEvent[]                   @relation("TrophyEventFromHolder")
  trophyEventsTo                 TrophyEvent[]                   @relation("TrophyEventToHolder")
  trophyPayouts                  TrophyPayout[]                  @relation("TrophyPayoutRecipient")
  trophyChallengesCreated        TrophyChallenge[]               @relation("TrophyChallengeChallenger")
  trophyChallengesDefended       TrophyChallenge[]               @relation("TrophyChallengeDefender")
  trophyChallengesGuarded        TrophyChallenge[]               @relation("TrophyChallengeGuardian")
  trophyChallengesWon            TrophyChallenge[]               @relation("TrophyChallengeWinner")
  trophySettingsChanged          TrophySetting[]                 @relation("TrophySettingChangedBy")
  eventTilesAsPlayerOne          EventTile[]                     @relation("EventTilePlayerOne")
  eventTilesAsPlayerTwo          EventTile[]                     @relation("EventTilePlayerTwo")
  eventTilesAsCommissioner       EventTile[]                     @relation("EventTileCommissioner")
  clanMemberships                ClanMember[]
  clanMessages                   ClanMessage[]
  clanMessageReactions           ClanMessageReaction[]
  forumThreads                   ForumThread[]                   @relation("ForumThreadAuthor")
  forumPosts                     ForumPost[]                     @relation("ForumPostAuthor")
  forumThreadBookmarks           ForumThreadBookmark[]
  forumThreadReactions           ForumThreadReaction[]
  replayResultAdjudications      ReplayResultAdjudication[]      @relation("ReplayResultAdjudicationActor")
  replayDesyncIncidents          ReplayDesyncIncident[]          @relation("ReplayDesyncIncidentReviewer")
  replaySubmissions              ReplaySubmission[]              @relation("ReplaySubmissionSubmitter")
  replayObservationPromotions    ReplayObservationPromotion[]    @relation("ReplayObservationPromotionActor")
  replayReprocessJobs            ReplayReprocessJob[]            @relation("ReplayReprocessJobCreator")
  replayPlayerSnapshots          ReplayPlayerSnapshot[]          @relation("ReplayPlayerSnapshotUser")
  replayPlayerMetricAggregates   ReplayPlayerMetricAggregate[]   @relation("ReplayPlayerMetricAggregateUser")
  replayStatProjections          ReplayStatProjection[]          @relation("ReplayStatProjectionActor")
  warEngineCasesCreated          WarEngineCase[]                 @relation("WarEngineCaseCreator")

  featureRequests         FeatureRequest[]        @relation("FeatureRequestRequester")
  bountyValuationsChanged BountyValuation[]       @relation("BountyValuationChangedBy")
  bountyClaims            BountyClaim[]           @relation("BountyClaimUser")
  replayRosterPromotions  ReplayRosterPromotion[] @relation("ReplayRosterPromotionActor")

  identityDecisionsActed        IdentityDecision[]              @relation("IdentityDecisionActor")
  identityDecisionSubjects      IdentityDecisionSubject[]       @relation("IdentityDecisionSubjectSiteAccount")
  warriorPlatformLinksCreated   WarriorPlatformLink[]           @relation("WarriorPlatformLinkCreator")
  warriorClaims                 WarriorClaim[]                  @relation("WarriorClaimSiteAccount")
  identityResolutionRunsCreated IdentityResolutionRun[]         @relation("IdentityResolutionRunCreator")
  identityPublicationsCreated   IdentityProjectionPublication[] @relation("IdentityProjectionPublicationActor")

  @@map("users")
}

model ApiKey {
  id         Int       @id @default(autoincrement())
  userId     Int       @map("user_id")
  kind       String    @default("watcher") @db.VarChar(20)
  keyPrefix  String    @unique @map("key_prefix") @db.VarChar(12)
  keyHash    String    @map("key_hash") @db.VarChar(255)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  lastUsedAt DateTime? @map("last_used_at") @db.Timestamp(6)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamp(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([userId], map: "ix_api_keys_user_id")
  @@index([keyPrefix], map: "ix_api_keys_prefix")
  @@map("api_keys")
}

model GameStats {
  id                  Int       @id @default(autoincrement())
  userUid             String?   @map("user_uid") @db.VarChar(100)
  replay_file         String    @db.VarChar(500)
  replayHash          String    @map("replay_hash") @db.VarChar(64)
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  game_version        String?   @db.VarChar(50)
  map                 Json?
  game_type           String?   @db.VarChar(50)
  duration            Int?
  game_duration       Int?
  winner              String?   @db.VarChar(100)
  players             Json?
  event_types         Json?
  key_events          Json?
  timestamp           DateTime? @default(now()) @db.Timestamp(6)
  played_on           DateTime? @db.Timestamp(6)
  parse_iteration     Int       @default(0)
  is_final            Boolean   @default(false)
  disconnect_detected Boolean   @default(false)
  parse_source        String    @default("unknown") @db.VarChar(20)
  parse_reason        String    @default("unspecified") @db.VarChar(50)
  original_filename   String?   @db.VarChar(255)

  user                        User?                         @relation(fields: [userUid], references: [uid], onDelete: NoAction, onUpdate: NoAction)
  linkedBetMarkets            BetMarket[]                   @relation("BetMarketLinkedGameStats")
  tournamentMatchProof        TournamentMatch?              @relation("TournamentMatchProof")
  replayParseAttempts         ReplayParseAttempt[]          @relation("GameStatsParseAttempts")
  replayResultAdjudications   ReplayResultAdjudication[]
  replayDesyncIncidents       ReplayDesyncIncident[]
  replayParseRuns             ReplayParseRun[]              @relation("ReplayParseRunGameStats")
  warEngineCase               WarEngineCase?
  replayEvidenceLinks         ReplayEvidenceLink[]          @relation("ReplayEvidenceLinkGameStats")
  replayObservationPromotions ReplayObservationPromotion[]  @relation("ReplayObservationPromotionGameStats")
  replayStatProjections       ReplayStatProjection[]
  replayPlayerSnapshots       ReplayPlayerSnapshot[]
  replayPlayerMetrics         ReplayPlayerMetric[]
  replayGameMetrics           ReplayGameMetric[]
  replayPlayerMetricBests     ReplayPlayerMetricAggregate[] @relation("ReplayPlayerMetricAggregateBestGame")
  trophyEvents                TrophyEvent[]
  trophyChallenges            TrophyChallenge[]
  replayRosterPromotions      ReplayRosterPromotion[]       @relation("ReplayRosterPromotionGameStats")

  identityProjections ReplayPlayerIdentityProjection[]

  @@unique([replayHash, is_final], map: "uq_replay_final")
  @@index([createdAt], map: "ix_game_stats_created_at")
  @@index([userUid], map: "ix_game_stats_user_uid")
  @@index([parse_source], map: "ix_game_stats_parse_source")
  @@index([replayHash, parse_iteration], map: "ix_replay_hash_iteration")
  @@index([replay_file, parse_iteration], map: "ix_replay_iteration")
  @@map("game_stats")
}

model ReplayParseAttempt {
  id               Int       @id @default(autoincrement())
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  userUid          String?   @map("user_uid") @db.VarChar(100)
  replayHash       String?   @map("replay_hash") @db.VarChar(64)
  originalFilename String?   @map("original_filename") @db.VarChar(255)
  parseSource      String    @default("file_upload") @map("parse_source") @db.VarChar(20)
  status           String    @default("received") @db.VarChar(32)
  detail           String?   @db.VarChar(255)
  uploadMode       String?   @map("upload_mode") @db.VarChar(20)
  fileSizeBytes    Int?      @map("file_size_bytes")
  gameStatsId      Int?      @map("game_stats_id")
  playedOn         DateTime? @map("played_on") @db.Timestamp(6)

  gameStats            GameStats?        @relation("GameStatsParseAttempts", fields: [gameStatsId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  engineRoomSubmission ReplaySubmission? @relation("ReplaySubmissionLegacyAttempt")
  engineRoomParseRuns  ReplayParseRun[]  @relation("ReplayParseRunLegacyAttempt")

  @@index([createdAt], map: "ix_replay_parse_attempts_created_at")
  @@index([status, createdAt], map: "ix_replay_parse_attempts_status_created_at")
  @@index([userUid, createdAt], map: "ix_replay_parse_attempts_user_uid_created_at")
  @@index([replayHash], map: "ix_replay_parse_attempts_replay_hash")
  @@index([gameStatsId], map: "ix_replay_parse_attempts_game_stats_id")
  @@index([gameStatsId, userUid], map: "ix_replay_parse_attempts_game_stats_user_uid")
  @@map("replay_parse_attempts")
}

/// Append-only human verdicts over immutable replay parser evidence.
/// Corrections are new rows linked through supersedesId; rows are never edited or deleted.
model ReplayResultAdjudication {
  id                       Int      @id @default(autoincrement())
  gameStatsId              Int      @map("game_stats_id")
  actorUserId              Int      @map("actor_user_id")
  supersedesId             Int?     @map("supersedes_id")
  idempotencyKey           String   @unique(map: "uq_replay_result_adjudications_idempotency") @map("idempotency_key") @db.VarChar(128)
  inputHash                String   @map("input_hash") @db.VarChar(64)
  decisionStatus           String   @default("accepted") @map("decision_status") @db.VarChar(32)
  actorUidSnapshot         String   @map("actor_uid_snapshot") @db.VarChar(100)
  actorDisplayNameSnapshot String   @map("actor_display_name_snapshot") @db.VarChar(100)
  actorRole                String   @map("actor_role") @db.VarChar(32)
  teamAssignments          Json     @map("team_assignments")
  winningTeamKey           String   @map("winning_team_key") @db.VarChar(128)
  winningPlayerKeys        Json     @map("winning_player_keys")
  reason                   String   @db.Text
  evidence                 Json?
  sourceReplayHash         String   @map("source_replay_hash") @db.VarChar(64)
  sourceParseIteration     Int      @map("source_parse_iteration")
  sourceRosterHash         String   @map("source_roster_hash") @db.VarChar(64)
  sourcePropositionHash    String   @map("source_proposition_hash") @db.VarChar(64)
  rawParserSnapshot        Json     @map("raw_parser_snapshot")
  marketSnapshot           Json?    @map("market_snapshot")
  hasLinkedMarket          Boolean  @default(false) @map("has_linked_market")
  financialDisposition     String   @default("none") @map("financial_disposition") @db.VarChar(40)
  affectsStats             Boolean  @default(false) @map("affects_stats")
  affectsBets              Boolean  @default(false) @map("affects_bets")
  createdAt                DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  gameStats             GameStats                    @relation(fields: [gameStatsId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  actor                 User                         @relation("ReplayResultAdjudicationActor", fields: [actorUserId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  supersedes            ReplayResultAdjudication?    @relation("ReplayResultAdjudicationSupersession", fields: [supersedesId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  supersededBy          ReplayResultAdjudication[]   @relation("ReplayResultAdjudicationSupersession")
  observationPromotions ReplayObservationPromotion[] @relation("ReplayObservationPromotionAdjudication")
  evidenceLinks         ReplayEvidenceLink[]         @relation("ReplayEvidenceLinkAdjudication")

  @@index([gameStatsId, decisionStatus, createdAt], map: "ix_replay_result_adjudications_game_status")
  @@index([actorUserId, createdAt], map: "ix_replay_result_adjudications_actor")
  @@index([supersedesId], map: "ix_replay_result_adjudications_supersedes")
  @@index([sourceReplayHash], map: "ix_replay_result_adjudications_replay_hash")
  @@map("replay_result_adjudications")
}

/// Append-only human ground truth about whether a replay desynced.
/// This ledger is deliberately independent of winner adjudication and settlement.
/// Corrections append a row linked through supersedesId; rows are never edited or deleted.
model ReplayDesyncIncident {
  id                          Int      @id @default(autoincrement())
  gameStatsId                 Int      @map("game_stats_id")
  scheduledMatchId            Int?     @map("scheduled_match_id")
  reviewerUserId              Int      @map("reviewer_user_id")
  supersedesId                Int?     @unique(map: "uq_replay_desync_incidents_supersedes") @map("supersedes_id")
  idempotencyKey              String   @unique(map: "uq_replay_desync_incidents_idempotency") @map("idempotency_key") @db.VarChar(128)
  inputHash                   String   @map("input_hash") @db.VarChar(64)
  desyncOccurred              Boolean  @map("desync_occurred")
  competitiveResultStatus     String   @default("unresolved") @map("competitive_result_status") @db.VarChar(24)
  settlementDisposition       String   @default("commissioner_review") @map("settlement_disposition") @db.VarChar(32)
  reviewerUidSnapshot         String   @map("reviewer_uid_snapshot") @db.VarChar(100)
  reviewerDisplayNameSnapshot String   @map("reviewer_display_name_snapshot") @db.VarChar(100)
  note                        String?  @db.Text
  sourceReplayHash            String   @map("source_replay_hash") @db.VarChar(64)
  sourceParseIteration        Int      @map("source_parse_iteration")
  parserDesyncCandidate       Boolean  @default(false) @map("parser_desync_candidate")
  machineEvidence             Json     @map("machine_evidence")
  createdAt                   DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  gameStats      GameStats             @relation(fields: [gameStatsId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  scheduledMatch ScheduledMatch?       @relation(fields: [scheduledMatchId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  reviewer       User                  @relation("ReplayDesyncIncidentReviewer", fields: [reviewerUserId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  supersedes     ReplayDesyncIncident? @relation("ReplayDesyncIncidentSupersession", fields: [supersedesId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  supersededBy   ReplayDesyncIncident? @relation("ReplayDesyncIncidentSupersession")

  @@index([gameStatsId, createdAt], map: "ix_replay_desync_incidents_game_created")
  @@index([scheduledMatchId, createdAt], map: "ix_replay_desync_incidents_match_created")
  @@index([reviewerUserId, createdAt], map: "ix_replay_desync_incidents_reviewer_created")
  @@index([desyncOccurred, createdAt], map: "ix_replay_desync_incidents_truth_created")
  @@index([parserDesyncCandidate, desyncOccurred], map: "ix_replay_desync_incidents_parser_ground_truth")
  @@index([sourceReplayHash], map: "ix_replay_desync_incidents_replay_hash")
  @@map("replay_desync_incidents")
}

/// Immutable content-addressed AoE2HD source bytes. A new storage fact is a new row;
/// archived artifact rows are never rewritten or deleted.
model ReplayArtifact {
  id                Int      @id @default(autoincrement())
  sha256            String   @unique(map: "uq_replay_artifacts_sha256") @db.VarChar(64)
  byteSize          BigInt   @map("byte_size")
  storageProvider   String   @default("filesystem") @map("storage_provider") @db.VarChar(32)
  storageKey        String   @unique(map: "uq_replay_artifacts_storage_key") @map("storage_key") @db.VarChar(1000)
  originalExtension String?  @map("original_extension") @db.VarChar(32)
  mediaType         String?  @map("media_type") @db.VarChar(100)
  headerFingerprint String?  @map("header_fingerprint") @db.VarChar(128)
  archiveMetadata   Json?    @map("archive_metadata")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  submissions ReplaySubmission[]
  parseRuns   ReplayParseRun[]
  jobEvents   ReplayReprocessJobEvent[]

  @@index([createdAt], map: "ix_replay_artifacts_created_at")
  @@map("replay_artifacts")
}

/// Immutable receipt linking a user/transport submission to content-addressed bytes.
/// Duplicate bytes may have many submissions; idempotent transport retries reuse one row.
model ReplaySubmission {
  id                   Int      @id @default(autoincrement())
  artifactId           Int      @map("artifact_id")
  submittedByUserId    Int?     @map("submitted_by_user_id")
  legacyParseAttemptId Int?     @unique(map: "uq_replay_submissions_legacy_attempt") @map("legacy_parse_attempt_id")
  idempotencyKey       String   @unique(map: "uq_replay_submissions_idempotency") @map("idempotency_key") @db.VarChar(128)
  submitterUidSnapshot String?  @map("submitter_uid_snapshot") @db.VarChar(100)
  source               String   @db.VarChar(32)
  originalFilename     String?  @map("original_filename") @db.VarChar(255)
  clientSubmissionId   String?  @map("client_submission_id") @db.VarChar(128)
  transportMetadata    Json?    @map("transport_metadata")
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  artifact           ReplayArtifact      @relation(fields: [artifactId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  submitter          User?               @relation("ReplaySubmissionSubmitter", fields: [submittedByUserId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  legacyParseAttempt ReplayParseAttempt? @relation("ReplaySubmissionLegacyAttempt", fields: [legacyParseAttemptId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  parseRuns          ReplayParseRun[]

  @@index([artifactId, createdAt], map: "ix_replay_submissions_artifact_created")
  @@index([submittedByUserId, createdAt], map: "ix_replay_submissions_user_created")
  @@index([source, createdAt], map: "ix_replay_submissions_source_created")
  @@map("replay_submissions")
}

/// One immutable, completed parser/pass execution. Runs only emit candidates and never
/// mutate GameStats or any public aggregate.
model ReplayParseRun {
  id                             Int      @id @default(autoincrement())
  artifactId                     Int      @map("artifact_id")
  submissionId                   Int?     @map("submission_id")
  legacyParseAttemptId           Int?     @map("legacy_parse_attempt_id")
  gameStatsId                    Int?     @map("game_stats_id")
  idempotencyKey                 String   @unique(map: "uq_replay_parse_runs_idempotency") @map("idempotency_key") @db.VarChar(128)
  runIdentityHash                String   @map("run_identity_hash") @db.VarChar(64)
  parserName                     String   @map("parser_name") @db.VarChar(64)
  parserVersion                  String   @map("parser_version") @db.VarChar(64)
  parserBuild                    String?  @map("parser_build") @db.VarChar(128)
  passName                       String   @map("pass_name") @db.VarChar(64)
  passVersion                    String   @map("pass_version") @db.VarChar(64)
  schemaVersion                  String   @map("schema_version") @db.VarChar(64)
  inputHash                      String   @map("input_hash") @db.VarChar(64)
  parserConfigHash               String   @map("parser_config_hash") @db.VarChar(64)
  status                         String   @db.VarChar(24)
  candidateOutputHash            String?  @map("candidate_output_hash") @db.VarChar(64)
  candidateOutputStorageProvider String?  @map("candidate_output_storage_provider") @db.VarChar(32)
  candidateOutputStorageKey      String?  @unique(map: "uq_replay_parse_runs_output_storage_key") @map("candidate_output_storage_key") @db.VarChar(1000)
  candidateOutputByteSize        BigInt?  @map("candidate_output_byte_size")
  observationCount               Int      @default(0) @map("observation_count")
  actionCount                    Int      @default(0) @map("action_count")
  failureSignature               String?  @map("failure_signature") @db.VarChar(128)
  failureDetail                  String?  @map("failure_detail") @db.Text
  metrics                        Json?
  candidateOnly                  Boolean  @default(true) @map("candidate_only")
  affectsPublicAggregates        Boolean  @default(false) @map("affects_public_aggregates")
  startedAt                      DateTime @map("started_at") @db.Timestamp(6)
  completedAt                    DateTime @map("completed_at") @db.Timestamp(6)
  createdAt                      DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  artifact                ReplayArtifact            @relation(fields: [artifactId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  submission              ReplaySubmission?         @relation(fields: [submissionId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  legacyParseAttempt      ReplayParseAttempt?       @relation("ReplayParseRunLegacyAttempt", fields: [legacyParseAttemptId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  gameStats               GameStats?                @relation("ReplayParseRunGameStats", fields: [gameStatsId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  observations            ReplayObservation[]
  evidenceLinks           ReplayEvidenceLink[]
  outputEvidenceArtifacts ReplayEvidenceArtifact[]  @relation("ReplayEvidenceSourceOutput")
  jobEvents               ReplayReprocessJobEvent[]
  statProjections         ReplayStatProjection[]
  warEngineRuns           WarEngineRun[]            @relation("WarEngineRunSourceParse")

  @@unique([artifactId, runIdentityHash], map: "uq_replay_parse_runs_artifact_identity")
  @@index([artifactId, createdAt], map: "ix_replay_parse_runs_artifact_created")
  @@index([gameStatsId, createdAt], map: "ix_replay_parse_runs_game_created")
  @@index([legacyParseAttemptId], map: "ix_replay_parse_runs_legacy_attempt")
  @@index([status, createdAt], map: "ix_replay_parse_runs_status_created")
  @@map("replay_parse_runs")
}

/// Immutable field/event candidate emitted by one parser run. Promotion is represented
/// by ReplayObservationPromotion, never by updating this row.
model ReplayObservation {
  id                      Int      @id @default(autoincrement())
  parseRunId              Int      @map("parse_run_id")
