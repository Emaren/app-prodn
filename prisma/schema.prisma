  platformLinks       WarriorPlatformLink[]
  claims              WarriorClaim[]
  projections         ReplayPlayerIdentityProjection[]
  decisionSubjects    IdentityDecisionSubject[]        @relation("IdentityDecisionSubjectWarrior")

  @@index([status, normalizedDisplayName], map: "ix_warriors_status_name")
  @@index([mergedIntoWarriorId], map: "ix_warriors_merged_into")
  @@index([mergedByDecisionId], map: "ix_warriors_merge_decision")
  @@map("warriors")
}

