  valueHash               String   @map("value_hash") @db.VarChar(64)
  confidenceBps           Int?     @map("confidence_bps")
  provenance              Json
  candidateOnly           Boolean  @default(true) @map("candidate_only")
  affectsPublicAggregates Boolean  @default(false) @map("affects_public_aggregates")
  createdAt               DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  parseRun         ReplayParseRun               @relation(fields: [parseRunId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  promotions       ReplayObservationPromotion[]
  evidenceLinks    ReplayEvidenceLink[]
  rosterPromotions ReplayRosterPromotion[]      @relation("ReplayRosterPromotionObservation")

  @@unique([parseRunId, observationKey], map: "uq_replay_observations_run_key")
  @@index([parseRunId, fieldPath], map: "ix_replay_observations_run_field")
