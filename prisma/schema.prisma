  @@index([gameStatsId], map: "ix_replay_evidence_links_game_stats")
  @@index([parseRunId], map: "ix_replay_evidence_links_parse_run")
  @@index([observationId], map: "ix_replay_evidence_links_observation")
  @@index([resultAdjudicationId], map: "ix_replay_evidence_links_adjudication")
  @@map("replay_evidence_links")
}

/// Immutable identity and safety boundary for a replay escalated beyond standard parsing.
/// Current state is derived from the append-only WarEngineCaseEvent stream.
model WarEngineCase {
  id                     Int      @id @default(autoincrement())
  gameStatsId            Int      @unique(map: "uq_war_engine_cases_game") @map("game_stats_id")
  createdByUserId        Int?     @map("created_by_user_id")
  idempotencyKey         String   @unique(map: "uq_war_engine_cases_idempotency") @map("idempotency_key") @db.VarChar(128)
  sourceReplayHashes     Json     @map("source_replay_hashes")
  initialTier            Int      @default(3) @map("initial_tier")
  initialReasonCode      String   @map("initial_reason_code") @db.VarChar(80)
  financialHistoryLocked Boolean  @default(true) @map("financial_history_locked")
  financialLockReason    String   @map("financial_lock_reason") @db.Text
  createdAt              DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  gameStats GameStats            @relation(fields: [gameStatsId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  createdBy User?                @relation("WarEngineCaseCreator", fields: [createdByUserId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  events    WarEngineCaseEvent[]
  runs      WarEngineRun[]

  @@index([createdByUserId, createdAt], map: "ix_war_engine_cases_creator_created")
  @@index([initialTier, createdAt], map: "ix_war_engine_cases_tier_created")
  @@map("war_engine_cases")
}

/// Append-only state, classification and public-copy stream for one War Engine case.
model WarEngineCaseEvent {
  id                Int      @id @default(autoincrement())
  caseId            Int      @map("case_id")
  idempotencyKey    String   @unique(map: "uq_war_engine_case_events_idempotency") @map("idempotency_key") @db.VarChar(128)
  sequence          Int
  eventType         String   @map("event_type") @db.VarChar(32)
  tier              Int
  status            String   @db.VarChar(32)
  classification    String?  @db.VarChar(40)
  publicLabel       String   @map("public_label") @db.VarChar(80)
  publicDetail      String   @map("public_detail") @db.Text
  winningTeamKey    String?  @map("winning_team_key") @db.VarChar(128)
  winningPlayerKeys Json     @default("[]") @map("winning_player_keys")
  confidenceBps     Int?     @map("confidence_bps")
  evidence          Json
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  case WarEngineCase @relation(fields: [caseId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@unique([caseId, sequence], map: "uq_war_engine_case_events_sequence")
  @@index([status, createdAt], map: "ix_war_engine_case_events_status_created")
  @@index([classification, createdAt], map: "ix_war_engine_case_events_class_created")
  @@map("war_engine_case_events")
}

/// Immutable execution fact for one deterministic, client-assisted or visual War Engine tier.
/// Runs are evidence-only and can never mutate public aggregates or historical betting state.
model WarEngineRun {
  id                      Int       @id @default(autoincrement())
  caseId                  Int       @map("case_id")
  sourceParseRunId        Int?      @map("source_parse_run_id")
  idempotencyKey          String    @unique(map: "uq_war_engine_runs_idempotency") @map("idempotency_key") @db.VarChar(128)
  runIdentityHash         String    @unique(map: "uq_war_engine_runs_identity") @map("run_identity_hash") @db.VarChar(64)
  tier                    Int
  engineName              String    @map("engine_name") @db.VarChar(64)
  engineVersion           String    @map("engine_version") @db.VarChar(64)
  engineBuild             String?   @map("engine_build") @db.VarChar(128)
  inputHash               String    @map("input_hash") @db.VarChar(64)
  status                  String    @db.VarChar(24)
  resultClassification    String?   @map("result_classification") @db.VarChar(40)
  resultTrusted           Boolean   @default(false) @map("result_trusted")
  winningTeamKey          String?   @map("winning_team_key") @db.VarChar(128)
  winningPlayerKeys       Json      @default("[]") @map("winning_player_keys")
  confidenceBps           Int?      @map("confidence_bps")
  finalState              Json?     @map("final_state")
  metrics                 Json?
  failureSignature        String?   @map("failure_signature") @db.VarChar(128)
  failureDetail           String?   @map("failure_detail") @db.Text
