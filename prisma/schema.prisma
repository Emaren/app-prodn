/// Player Identity foundation. These models are additive and are not read
/// by public or financial paths until a later reviewed cutover.
model Warrior {
  id                    Int      @id @default(autoincrement())
  publicId              String   @unique @default(cuid()) @map("public_id") @db.VarChar(32)
  seedPlatformAccountId Int?     @unique(map: "uq_warriors_seed_platform_account") @map("seed_platform_account_id")
  kind                  String   @default("platform_seed") @db.VarChar(32)
  preferredDisplayName  String   @map("preferred_display_name") @db.VarChar(100)
  normalizedDisplayName String   @map("normalized_display_name") @db.VarChar(100)
  status                String   @default("provisional") @db.VarChar(24)
  mergedIntoWarriorId   Int?     @map("merged_into_warrior_id")
  mergedByDecisionId    Int?     @map("merged_by_decision_id")
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt             DateTime @updatedAt @map("updated_at") @db.Timestamp(6)

  seedPlatformAccount PlatformAccount?                 @relation("WarriorSeedPlatform", fields: [seedPlatformAccountId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  mergedInto          Warrior?                         @relation("WarriorMerge", fields: [mergedIntoWarriorId], references: [id], onDelete: Restrict, onUpdate: NoAction)
