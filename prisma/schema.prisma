/// Append-only materialized numeric aggregate. Coverage counts keep missing
/// observations distinct from real zeroes and resolved-result scope explicit.
model ReplayPlayerMetricAggregate {
  id                      Int      @id @default(autoincrement())
  userId                  Int?     @map("user_id")
  bestGameStatsId         Int?     @map("best_game_stats_id")
  idempotencyKey          String   @unique(map: "uq_replay_player_metric_aggregates_idempotency") @map("idempotency_key") @db.VarChar(128)
  buildKey                String   @map("build_key") @db.VarChar(128)
  inputHash               String   @map("input_hash") @db.VarChar(64)
  playerKey               String   @map("player_key") @db.VarChar(160)
  metricKey               String   @map("metric_key") @db.VarChar(160)
  metricGroup             String   @map("metric_group") @db.VarChar(32)
  unit                    String   @db.VarChar(32)
  schemaVersion           String   @map("schema_version") @db.VarChar(64)
  metricDictionaryVersion String   @map("metric_dictionary_version") @db.VarChar(64)
  aggregateVersion        String   @map("aggregate_version") @db.VarChar(64)
  scopeKey                String   @default("career") @map("scope_key") @db.VarChar(64)
  dimension               Json
  dimensionHash           String   @map("dimension_hash") @db.VarChar(64)
  resultScope             String   @default("all_stat_eligible") @map("result_scope") @db.VarChar(32)
  sourceProjectionCount   Int      @map("source_projection_count")
  totalGameCount          Int      @map("total_game_count")
  statEligibleGameCount   Int      @map("stat_eligible_game_count")
  resultEligibleGameCount Int      @map("result_eligible_game_count")
  metricGameCount         Int      @map("metric_game_count")
  coverageBps             Int      @map("coverage_bps")
  numericSum              Decimal  @map("numeric_sum") @db.Decimal(30, 6)
  numericAverage          Decimal  @map("numeric_average") @db.Decimal(30, 6)
  numericMinimum          Decimal  @map("numeric_minimum") @db.Decimal(30, 6)
  numericMaximum          Decimal  @map("numeric_maximum") @db.Decimal(30, 6)
  createdAt               DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  user     User?      @relation("ReplayPlayerMetricAggregateUser", fields: [userId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  bestGame GameStats? @relation("ReplayPlayerMetricAggregateBestGame", fields: [bestGameStatsId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@unique([buildKey, playerKey, metricKey, scopeKey, dimensionHash, resultScope], map: "uq_replay_player_metric_aggregates_build_target")
  @@index([playerKey, metricKey, createdAt], map: "ix_replay_player_metric_aggregates_player_key")
  @@index([userId, metricKey, createdAt], map: "ix_replay_player_metric_aggregates_user_key")
  @@index([buildKey], map: "ix_replay_player_metric_aggregates_build")
  @@map("replay_player_metric_aggregates")
}

/// Immutable content-addressed screenshot, trace, OCR, or operator evidence object.
model ReplayEvidenceArtifact {
  id                        Int       @id @default(autoincrement())
  sha256                    String    @unique(map: "uq_replay_evidence_artifacts_sha256") @db.VarChar(64)
