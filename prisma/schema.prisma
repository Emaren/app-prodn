}

model IdentityResolutionRun {
  id                      Int       @id @default(autoincrement())
  publicId                String    @unique @default(cuid()) @map("public_id") @db.VarChar(32)
  runKey                  String    @unique @map("run_key") @db.VarChar(128)
  resolverVersion         String    @map("resolver_version") @db.VarChar(64)
  normalizationVersion    String    @map("normalization_version") @db.VarChar(32)
  schemaVersion           String    @map("schema_version") @db.VarChar(32)
  comparisonPolicyVersion String?   @map("comparison_policy_version") @db.VarChar(32)
  mode                    String    @db.VarChar(24)
  sourceWatermark         Json      @map("source_watermark")
  inputHash               String    @map("input_hash") @db.VarChar(64)
  resultHash              String?   @map("result_hash") @db.VarChar(64)
  status                  String    @default("running") @db.VarChar(24)
  counts                  Json?
  mismatchSummary         Json?     @map("mismatch_summary")
  failureSummary          Json?     @map("failure_summary")
  startedAt               DateTime  @default(now()) @map("started_at") @db.Timestamp(6)
  completedAt             DateTime? @map("completed_at") @db.Timestamp(6)
  createdByUserId         Int?      @map("created_by_user_id")
  createdAt               DateTime  @default(now()) @map("created_at") @db.Timestamp(6)

  createdBy    User?                            @relation("IdentityResolutionRunCreator", fields: [createdByUserId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  projections  ReplayPlayerIdentityProjection[]
  publications IdentityProjectionPublication[]

  @@index([resolverVersion, mode, inputHash], map: "ix_identity_resolution_runs_version_mode_input")
  @@index([status, completedAt], map: "ix_identity_resolution_runs_status_completed")
  @@map("identity_resolution_runs")
}

model ReplayPlayerIdentityProjection {
  id                     Int      @id @default(autoincrement())
  resolutionRunId        Int      @map("resolution_run_id")
  replayPlayerSnapshotId Int      @map("replay_player_snapshot_id")
  gameStatsId            Int      @map("game_stats_id")
  effectiveGameAt        DateTime @map("effective_game_at") @db.Timestamp(6)
  gameTimeSource         String   @map("game_time_source") @db.VarChar(32)
  platformAccountId      Int?     @map("platform_account_id")
  provisionalIdentityId  Int?     @map("provisional_identity_id")
  warriorId              Int?     @map("warrior_id")
  warriorPlatformLinkId  Int?     @map("warrior_platform_link_id")
  resolutionStatus       String   @map("resolution_status") @db.VarChar(32)
  aggregateEligible      Boolean  @default(false) @map("aggregate_eligible")
  exclusionReason        String?  @map("exclusion_reason") @db.VarChar(64)
  exact                  Boolean  @default(false)
  confidenceBps          Int?     @map("confidence_bps")
  reasonCode             String   @map("reason_code") @db.VarChar(64)
  inputHash              String   @map("input_hash") @db.VarChar(64)
  projectionHash         String   @map("projection_hash") @db.VarChar(64)
  provenance             Json
  createdAt              DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  resolutionRun       IdentityResolutionRun @relation(fields: [resolutionRunId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  replaySnapshot      ReplayPlayerSnapshot  @relation(fields: [replayPlayerSnapshotId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  gameStats           GameStats             @relation(fields: [gameStatsId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  platformAccount     PlatformAccount?      @relation(fields: [platformAccountId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  provisionalIdentity ProvisionalIdentity?  @relation(fields: [provisionalIdentityId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  warrior             Warrior?              @relation(fields: [warriorId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  warriorPlatformLink WarriorPlatformLink?  @relation(fields: [warriorPlatformLinkId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@unique([resolutionRunId, replayPlayerSnapshotId], map: "uq_replay_player_identity_projection_run_snapshot")
  @@index([resolutionRunId, resolutionStatus], map: "ix_replay_player_identity_projection_run_status")
  @@index([warriorId, aggregateEligible, gameStatsId], map: "ix_replay_player_identity_projection_warrior_game")
  @@index([platformAccountId, gameStatsId], map: "ix_replay_player_identity_projection_platform_game")
  @@index([provisionalIdentityId, gameStatsId], map: "ix_replay_player_identity_projection_provisional_game")
  @@map("replay_player_identity_projections")
}

model IdentityProjectionPublication {
  id                       Int      @id @default(autoincrement())
  publicationKey           String   @unique @map("publication_key") @db.VarChar(128)
  scope                    String   @db.VarChar(32)
  action                   String   @db.VarChar(24)
  resolutionRunId          Int?     @map("resolution_run_id")
  predecessorPublicationId Int?     @unique(map: "uq_identity_projection_publication_predecessor") @map("predecessor_publication_id")
  reason                   String   @db.VarChar(1000)
  publishedByUserId        Int?     @map("published_by_user_id")
  createdAt                DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  resolutionRun IdentityResolutionRun?         @relation(fields: [resolutionRunId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  predecessor   IdentityProjectionPublication? @relation("IdentityPublicationChain", fields: [predecessorPublicationId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  successor     IdentityProjectionPublication? @relation("IdentityPublicationChain")
  publishedBy   User?                          @relation("IdentityProjectionPublicationActor", fields: [publishedByUserId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@index([scope, id], map: "ix_identity_projection_publications_scope_id")
  @@index([resolutionRunId], map: "ix_identity_projection_publications_run")
  @@map("identity_projection_publications")
}

model alembic_version {
  version_num String @id(map: "alembic_version_pkc") @db.VarChar(32)
}

/// Append-only authority for projecting exact replay participant rosters publicly.
/// This ledger grants participation/team authority only. It can never grant result,
/// betting, payout or settlement authority.
model ReplayRosterPromotion {
  id                      Int      @id @default(autoincrement())
  observationId           Int      @map("observation_id")
  gameStatsId             Int      @map("game_stats_id")
  promotedByUserId        Int?     @map("promoted_by_user_id")
  idempotencyKey          String   @unique(map: "uq_replay_roster_promotions_idempotency") @map("idempotency_key") @db.VarChar(128)
  promotionKey            String   @map("promotion_key") @db.VarChar(255)
  decisionHash            String   @map("decision_hash") @db.VarChar(64)
  policyVersion           String   @map("policy_version") @db.VarChar(64)
  replayHash              String   @map("replay_hash") @db.VarChar(64)
  previousPlayersHash     String   @map("previous_players_hash") @db.VarChar(64)
  projectedPlayersHash    String   @map("projected_players_hash") @db.VarChar(64)
  format                  String   @db.VarChar(16)
  playerCount             Int      @map("player_count")
  previousPlayers         Json     @map("previous_players")
  projectedPlayers        Json     @map("projected_players")
  reason                  String   @db.Text
  affectsPublicAggregates Boolean  @default(true) @map("affects_public_aggregates")
  affectsResults          Boolean  @default(false) @map("affects_results")
  affectsBets             Boolean  @default(false) @map("affects_bets")
  settlementAuthority     Boolean  @default(false) @map("settlement_authority")
  createdAt               DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  observation ReplayObservation @relation("ReplayRosterPromotionObservation", fields: [observationId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  gameStats   GameStats         @relation("ReplayRosterPromotionGameStats", fields: [gameStatsId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  promotedBy  User?             @relation("ReplayRosterPromotionActor", fields: [promotedByUserId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@unique([observationId, promotionKey], map: "uq_replay_roster_promotions_observation_key")
  @@unique([gameStatsId, promotionKey], map: "uq_replay_roster_promotions_game_key")
  @@index([gameStatsId, createdAt], map: "ix_replay_roster_promotions_game_created")
  @@index([promotedByUserId, createdAt], map: "ix_replay_roster_promotions_actor_created")
  @@map("replay_roster_promotions")
}
