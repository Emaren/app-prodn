}

/// Immutable normalization receipt over one replay and one source state.
/// Candidate projections remain private. Only explicitly accepted projections
/// may feed public statistics, and no projection can alter results or money.
model ReplayStatProjection {
  id                      Int      @id @default(autoincrement())
  gameStatsId             Int      @map("game_stats_id")
  parseRunId              Int?     @map("parse_run_id")
  supersedesId            Int?     @unique(map: "uq_replay_stat_projections_supersedes") @map("supersedes_id")
  projectedByUserId       Int?     @map("projected_by_user_id")
  projectedByUidSnapshot  String?  @map("projected_by_uid_snapshot") @db.VarChar(100)
  idempotencyKey          String   @unique(map: "uq_replay_stat_projections_idempotency") @map("idempotency_key") @db.VarChar(128)
  projectionIdentityHash  String   @map("projection_identity_hash") @db.VarChar(64)
  inputHash               String   @map("input_hash") @db.VarChar(64)
  projectionHash          String   @map("projection_hash") @db.VarChar(64)
  sourceKind              String   @map("source_kind") @db.VarChar(32)
  sourceIdentity          String   @map("source_identity") @db.VarChar(160)
  sourceHash              String   @map("source_hash") @db.VarChar(64)
  parserName              String?  @map("parser_name") @db.VarChar(64)
  parserVersion           String?  @map("parser_version") @db.VarChar(64)
  passName                String?  @map("pass_name") @db.VarChar(64)
  passVersion             String?  @map("pass_version") @db.VarChar(64)
  schemaVersion           String   @map("schema_version") @db.VarChar(64)
  metricDictionaryVersion String   @map("metric_dictionary_version") @db.VarChar(64)
  projectionPolicyVersion String   @map("projection_policy_version") @db.VarChar(64)
  projectionStatus        String   @default("candidate") @map("projection_status") @db.VarChar(24)
  statEligibility         String   @default("eligible") @map("stat_eligibility") @db.VarChar(24)
  statEligibilityReason   String?  @map("stat_eligibility_reason") @db.VarChar(160)
  resultEligibility       String   @default("unresolved") @map("result_eligibility") @db.VarChar(24)
  resultEligibilityReason String?  @map("result_eligibility_reason") @db.VarChar(160)
  playerCount             Int      @default(0) @map("player_count")
  playerMetricCount       Int      @default(0) @map("player_metric_count")
  gameMetricCount         Int      @default(0) @map("game_metric_count")
  provenance              Json
  affectsPublicAggregates Boolean  @default(false) @map("affects_public_aggregates")
  affectsResults          Boolean  @default(false) @map("affects_results")
  affectsBets             Boolean  @default(false) @map("affects_bets")
  settlementAuthority     Boolean  @default(false) @map("settlement_authority")
  createdAt               DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  gameStats       GameStats              @relation(fields: [gameStatsId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  parseRun        ReplayParseRun?        @relation(fields: [parseRunId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  supersedes      ReplayStatProjection?  @relation("ReplayStatProjectionSupersession", fields: [supersedesId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  supersededBy    ReplayStatProjection?  @relation("ReplayStatProjectionSupersession")
  projectedBy     User?                  @relation("ReplayStatProjectionActor", fields: [projectedByUserId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  playerSnapshots ReplayPlayerSnapshot[]
  playerMetrics   ReplayPlayerMetric[]
  gameMetrics     ReplayGameMetric[]

  @@unique([gameStatsId, projectionIdentityHash], map: "uq_replay_stat_projections_game_identity")
  @@index([gameStatsId, projectionStatus, createdAt], map: "ix_replay_stat_projections_game_status")
  @@index([parseRunId], map: "ix_replay_stat_projections_parse_run")
  @@index([projectedByUserId, createdAt], map: "ix_replay_stat_projections_actor")
  @@index([sourceKind, createdAt], map: "ix_replay_stat_projections_source")
  @@map("replay_stat_projections")
}

/// One player identity and eligibility snapshot within an immutable projection.
/// Result eligibility is deliberately independent from statistical eligibility.
model ReplayPlayerSnapshot {
  id                Int      @id @default(autoincrement())
  projectionId      Int      @map("projection_id")
  gameStatsId       Int      @map("game_stats_id")
  userId            Int?     @map("user_id")
  idempotencyKey    String   @unique(map: "uq_replay_player_snapshots_idempotency") @map("idempotency_key") @db.VarChar(128)
  playerKey         String   @map("player_key") @db.VarChar(160)
  displayName       String   @map("display_name") @db.VarChar(100)
  normalizedName    String   @map("normalized_name") @db.VarChar(100)
  steamId           String?  @map("steam_id") @db.VarChar(32)
  playerSlot        Int?     @map("player_slot")
  teamKey           String?  @map("team_key") @db.VarChar(64)
  civilizationId    Int?     @map("civilization_id")
  civilizationName  String?  @map("civilization_name") @db.VarChar(100)
  statEligible      Boolean  @default(true) @map("stat_eligible")
  resultEligible    Boolean  @default(false) @map("result_eligible")
  resultStatus      String   @default("unresolved") @map("result_status") @db.VarChar(24)
  eligibilityReason Json?    @map("eligibility_reason")
  exact             Boolean  @default(true)
  confidenceBps     Int?     @map("confidence_bps")
  provenance        Json
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  projection ReplayStatProjection @relation(fields: [projectionId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  gameStats  GameStats            @relation(fields: [gameStatsId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  user       User?                @relation("ReplayPlayerSnapshotUser", fields: [userId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  metrics    ReplayPlayerMetric[]

  platformNameObservations PlatformNameObservation[]
  identityProjections      ReplayPlayerIdentityProjection[]
  identityDecisionSubjects IdentityDecisionSubject[]        @relation("IdentityDecisionSubjectReplaySnapshot")

  @@unique([projectionId, playerKey], map: "uq_replay_player_snapshots_projection_player")
  @@index([playerKey, createdAt], map: "ix_replay_player_snapshots_player_created")
  @@index([userId, createdAt], map: "ix_replay_player_snapshots_user_created")
  @@index([gameStatsId, playerKey], map: "ix_replay_player_snapshots_game_player")
  @@map("replay_player_snapshots")
}

/// Typed, immutable per-player metric. Exactly one typed value column is set.
/// A stored numeric zero is a real value; unavailable metrics have no row.
model ReplayPlayerMetric {
  id                Int      @id @default(autoincrement())
  projectionId      Int      @map("projection_id")
  playerSnapshotId  Int      @map("player_snapshot_id")
  gameStatsId       Int      @map("game_stats_id")
  idempotencyKey    String   @unique(map: "uq_replay_player_metrics_idempotency") @map("idempotency_key") @db.VarChar(128)
  metricKey         String   @map("metric_key") @db.VarChar(160)
  metricGroup       String   @map("metric_group") @db.VarChar(32)
  valueType         String   @map("value_type") @db.VarChar(16)
  numericValue      Decimal? @map("numeric_value") @db.Decimal(30, 6)
  textValue         String?  @map("text_value") @db.VarChar(500)
  booleanValue      Boolean? @map("boolean_value")
  unit              String   @db.VarChar(32)
  aggregationMethod String   @map("aggregation_method") @db.VarChar(24)
  resultDependency  String   @default("none") @map("result_dependency") @db.VarChar(24)
  statEligible      Boolean  @default(true) @map("stat_eligible")
  exact             Boolean  @default(true)
  confidenceBps     Int?     @map("confidence_bps")
  sourceKind        String   @map("source_kind") @db.VarChar(32)
  sourcePath        String   @map("source_path") @db.VarChar(255)
  provenance        Json
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  projection     ReplayStatProjection @relation(fields: [projectionId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  playerSnapshot ReplayPlayerSnapshot @relation(fields: [playerSnapshotId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  gameStats      GameStats            @relation(fields: [gameStatsId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@unique([playerSnapshotId, metricKey], map: "uq_replay_player_metrics_snapshot_key")
  @@index([gameStatsId, metricKey], map: "ix_replay_player_metrics_game_key")
  @@index([metricKey, statEligible, createdAt], map: "ix_replay_player_metrics_key_eligible")
  @@index([projectionId], map: "ix_replay_player_metrics_projection")
  @@map("replay_player_metrics")
}

