  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  evidenceArtifact   ReplayEvidenceArtifact    @relation(fields: [evidenceArtifactId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  gameStats          GameStats?                @relation("ReplayEvidenceLinkGameStats", fields: [gameStatsId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  parseRun           ReplayParseRun?           @relation(fields: [parseRunId], references: [id], onDelete: Restrict, onUpdate: NoAction)
