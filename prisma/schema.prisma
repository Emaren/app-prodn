  reason          String?   @db.VarChar(500)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamp(6)

  opportunity BountyOpportunity @relation(fields: [opportunityId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  changedBy   User?             @relation("BountyValuationChangedBy", fields: [changedByUserId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  claims      BountyClaim[]

  @@index([opportunityId, effectiveFrom], map: "ix_bounty_valuations_opportunity_effective")
  @@index([changedByUserId, createdAt], map: "ix_bounty_valuations_changed_by")
  @@map("bounty_valuations")
}

/// A bounty reward freezes here when eligibility locks. Later valuation changes
/// cannot alter rewardSnapshotWolo for this claim.
model BountyClaim {
  id                        Int       @id @default(autoincrement())
  publicId                  String    @unique @default(uuid()) @map("public_id") @db.Uuid
  idempotencyKey            String    @unique @map("idempotency_key") @db.VarChar(160)
  opportunityId             Int       @map("opportunity_id")
  valuationId               Int       @map("valuation_id")
  userId                    Int       @map("user_id")
  playerDisplayNameSnapshot String    @map("player_display_name_snapshot") @db.VarChar(120)
  recipientAddressSnapshot  String?   @map("recipient_address_snapshot") @db.VarChar(100)
  rewardSnapshotWolo        Int       @map("reward_snapshot_wolo")
  status                    String    @default("qualified") @db.VarChar(24)
  evidence                  Json?
  eligibilityLockedAt       DateTime  @default(now()) @map("eligibility_locked_at") @db.Timestamp(6)
  approvedAt                DateTime? @map("approved_at") @db.Timestamp(6)
  completedAt               DateTime? @map("completed_at") @db.Timestamp(6)
  cancelledAt               DateTime? @map("cancelled_at") @db.Timestamp(6)
  createdAt                 DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt                 DateTime  @updatedAt @map("updated_at") @db.Timestamp(6)

  opportunity BountyOpportunity @relation(fields: [opportunityId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  valuation   BountyValuation   @relation(fields: [valuationId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  user        User              @relation("BountyClaimUser", fields: [userId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  payout      BountyPayout?

  @@index([opportunityId, status, createdAt], map: "ix_bounty_claims_opportunity_status")
  @@index([userId, createdAt], map: "ix_bounty_claims_user_created")
  @@index([valuationId], map: "ix_bounty_claims_valuation")
  @@map("bounty_claims")
}

/// Durable proof of an actual bounty payment. Chain truth remains authoritative
/// for whether WOLO moved.
model BountyPayout {
  id               Int       @id @default(autoincrement())
  claimId          Int       @unique @map("claim_id")
  requestId        String    @unique @map("request_id") @db.VarChar(160)
  amountWolo       Int       @map("amount_wolo")
  recipientAddress String    @map("recipient_address") @db.VarChar(100)
  status           String    @default("pending") @db.VarChar(24)
  txHash           String?   @map("tx_hash") @db.VarChar(128)
  errorDetail      String?   @map("error_detail") @db.VarChar(500)
  paidAt           DateTime? @map("paid_at") @db.Timestamp(6)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamp(6)

  claim BountyClaim @relation(fields: [claimId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@index([status, createdAt], map: "ix_bounty_payouts_status_created")
  @@index([txHash], map: "ix_bounty_payouts_tx_hash")
  @@map("bounty_payouts")
}

