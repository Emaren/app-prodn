  requesterAddress             String  @map("requester_address") @db.VarChar(100)
  requestText                  String? @map("request_text") @db.Text

  sponsorAmountWolo       Int     @default(100) @map("sponsor_amount_wolo")
  sponsorAmountUwolo      BigInt? @map("sponsor_amount_uwolo")
  sponsorRecipientAddress String  @map("sponsor_recipient_address") @db.VarChar(100)
  sponsorMemo             String  @unique @map("sponsor_memo") @db.VarChar(255)
  sponsorTxHash           String? @unique @map("sponsor_tx_hash") @db.VarChar(128)
  paymentStatus           String  @default("awaiting_payment") @map("payment_status") @db.VarChar(24)

  status         String  @default("awaiting_payment") @db.VarChar(24)
  acceptedByUid  String? @map("accepted_by_uid") @db.VarChar(100)
  completedByUid String? @map("completed_by_uid") @db.VarChar(100)
  adminNote      String? @map("admin_note") @db.Text

  refundStatus     String  @default("not_required") @map("refund_status") @db.VarChar(24)
  refundAmountWolo Int?    @map("refund_amount_wolo")
  refundTxHash     String? @map("refund_tx_hash") @db.VarChar(128)

  developmentValueWolo Int? @map("development_value_wolo")
  workshopEntryId      Int? @unique @map("workshop_entry_id")

  sponsoredAt DateTime? @map("sponsored_at") @db.Timestamp(6)
  submittedAt DateTime? @map("submitted_at") @db.Timestamp(6)
  acceptedAt  DateTime? @map("accepted_at") @db.Timestamp(6)
  startedAt   DateTime? @map("started_at") @db.Timestamp(6)
  completedAt DateTime? @map("completed_at") @db.Timestamp(6)
  declinedAt  DateTime? @map("declined_at") @db.Timestamp(6)
  refundedAt  DateTime? @map("refunded_at") @db.Timestamp(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamp(6)

  requester     User           @relation("FeatureRequestRequester", fields: [requesterUserId], references: [id], onDelete: Restrict, onUpdate: NoAction)
