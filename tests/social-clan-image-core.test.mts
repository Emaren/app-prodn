import test from "node:test";import assert from "node:assert/strict";import {mkdtemp,chmod,readdir,readFile,rm} from "node:fs/promises";import path from "node:path";import os from "node:os";
import {executeSocialClanImageWrite,executeSocialClanImageRead} from "../lib/socialClanImageCore.mjs";
import {readRestrictedClanImage} from "../lib/restrictedClanImageStorage.mjs";
const input={slug:"alpha",requestKey:"a".repeat(32),name:"x.png",mimeType:"image/png",imageBase64:"AQID"},token="a".repeat(64),verifySession=async()=>"alice",verifyImage=async()=>true;
const fixture=async(fn)=>{const root=await mkdtemp(path.join(await import("node:fs/promises").then(m=>m.realpath(os.tmpdir())),"clan-image-"));await chmod(root,0o750);try{await fn(root)}finally{await rm(root,{recursive:true,force:true})}};
const mock=(d,commitFail=false)=>{const calls=[];return {calls,pool:{connect:async()=>({query:async(q,args)=>{calls.push([q,args]);if(commitFail&&q==="COMMIT")throw Error("unknown");return {rows:[{decision:d}]}},release:()=>{}})}}};
const write=(root,m,extra={})=>executeSocialClanImageWrite({pool:m.pool,root,verifySession,verifyImage,sessionToken:token,input,...extra});
test("one committed private image and exact fixed SQL",()=>fixture(async root=>{const m=mock({status:201,messageId:2,attachmentId:3,replayed:false});const r=await write(root,m);assert.equal(r.status,201);const [name]=await readdir(root);assert.match(name,/^clan-[a-f0-9]{32}\.png$/);assert.deepEqual(await readFile(path.join(root,name)),Buffer.from([1,2,3]));assert.deepEqual(m.calls[3][1].slice(0,3),["alice","alpha","a".repeat(32)]);assert.equal((await readRestrictedClanImage(root,"file:v1:"+name,"image/png",3)).buffer.length,3);assert.equal(await readRestrictedClanImage(root,"file:v1:"+name,"image/png",2),null)}));
test("replay removes only provisional file",()=>fixture(async root=>{const r=await write(root,mock({status:201,messageId:2,attachmentId:3,replayed:true}));assert.equal(r.body.replayed,true);assert.deepEqual(await readdir(root),[])}));
test("denial rolls back and removes provisional",()=>fixture(async root=>{const r=await write(root,mock({status:403,detail:"CLAN_MEMBERSHIP_REQUIRED"}));assert.equal(r.status,403);assert.deepEqual(await readdir(root),[])}));
test("uncertain commit retains file for reconciliation",()=>fixture(async root=>{const r=await write(root,mock({status:201,messageId:2,attachmentId:3,replayed:false},true));assert.equal(r.status,503);assert.equal((await readdir(root)).length,1)}));
test("invalid actor injection or caption never opens DB",()=>fixture(async root=>{const m=mock(null);assert.equal((await write(root,m,{input:{...input,actor:"bob"}})).status,400);assert.equal((await write(root,m,{input:{...input,body:"caption"}})).status,400);assert.equal(m.calls.length,0)}));
test("read exact ledger-backed SQL, reject mismatched MIME and absent membership",async()=>{const ref="file:v1:clan-"+"a".repeat(32)+".png";const call=m=>executeSocialClanImageRead({pool:m.pool,verifySession,sessionToken:token,input:{slug:"alpha",attachmentId:3}});const m=mock({storageRef:ref,mimeType:"image/png",name:"x.png",sizeBytes:3});assert.equal((await call(m)).status,200);assert.deepEqual(m.calls[3][1],["alice","alpha",3]);assert.equal((await call(mock(null))).status,404);assert.equal((await call(mock({storageRef:ref,mimeType:"image/jpeg",name:"x.jpg",sizeBytes:3}))).status,503)});
